<?xml version="1.0" encoding="utf-8"?>
<!-- Bố cục xem trước hiển thị trong khay Chọn Tiện Ích trên Android 12+ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F7F4"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thời tiết &amp; Giờ Material"
        android:textColor="#13201B"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="TP. Hồ Chí Minh · 31°C"
        android:textColor="#445850"
        android:textSize="13sp" />
</LinearLayout>
